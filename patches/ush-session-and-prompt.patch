+    // Use Starship itself so directory formatting, colors and status agree
+    // with the same configuration in every shell.
+    if starship.is_some() {
+        let output = std::process::Command::new("@originStarship@")
+            .args(["prompt", "--status", &last_status.to_string(), "--path"])
+            .arg(cwd)
+            .current_dir(cwd)
+            .env("STARSHIP_SHELL", "ush")
+            .output();
+        if let Ok(output) = output {
+            if output.status.success() && !output.stdout.is_empty() {
+                if let Ok(prompt) = String::from_utf8(output.stdout) {
+                    return prompt;
+                }
+            }
+        }
