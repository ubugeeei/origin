let
  package :: dynamic;
  # @tnix-ignore
  package = (args :: {
    stdenvNoCC :: dynamic;
    fetchurl :: dynamic;
    lib :: dynamic;
  }):
let
  stdenvNoCC = args.stdenvNoCC;
  fetchurl = args.fetchurl;
  lib = args.lib;
  platform = stdenvNoCC.hostPlatform;

  macPackages = {
    aarch64 = {
      packageName = "darwin-arm64";
      hash = "sha512-C7O1kN10VYhBPmRYV/lYxC5HRGJtw4JimuwLdgggEpo37ko8OsIkMcfLVDB1HFCioA8gpO4jW81oBMvpNWrpqQ==";
    };
    x86_64 = {
      packageName = "darwin-x64";
      hash = "sha512-yN9GRaGvUzV8WrPwtifomVEhOaHmORLpihlr4SJOWAkYjWj0+6hG4aKg8UxUidNj7YLTkMNN15IBXN/29kE/Zw==";
    };
  };

  linuxPackages = {
    aarch64 = {
      gnu = {
        packageName = "linux-arm64-gnu";
        hash = "sha512-aWT2U4SN3w8w+AkgPCL98NyesnS0dLUPz9MLX9UvwOXCdDEsDLghhnsKWh7kD+6YAC6W3lEpcmZGD6grcUTOwg==";
      };
      musl = {
        packageName = "linux-arm64-musl";
        hash = "sha512-GpDkSTU+ks3hq/uaQ5RBVcrBP0K+EjwWdoWvmSqoX031oNpiWyCj9b/kmgJQUclyDj+gmVA8veFnwMUYwFfJIA==";
      };
    };
    x86_64 = {
      gnu = {
        packageName = "linux-x64-gnu";
        hash = "sha512-WNQaEN1S5MOQpfDH45Gz6wqBL1vxUfTRTCS4k8HA7UyIT1B6wkik1+ONIlxXQ7pctsTlxl/XSqkhY8zrlppyxw==";
      };
      musl = {
        packageName = "linux-x64-musl";
        hash = "sha512-ykRBudkE60heBiBZmSB8BHup4qdsTQyeGSu+7+BVGTSvL/28Z1S4SJvsnBxQlD1EeEUDRgqD51oheHzlzXQc9Q==";
      };
    };
  };

  winPackages = {
    aarch64 = {
      packageName = "win32-arm64-msvc";
      hash = "sha512-3TbW1o56DlY/y23qauEztnTvw+OMdGitVXnk2Qba7sr5NdP6mUeAyfA9lDpc45eQxvkRtyggKcBK4D7nmGNzeA==";
    };
    x86_64 = {
      packageName = "win32-x64-msvc";
      hash = "sha512-hoTsOGZmFKv7PQ7/VBoC3mo4x+fOgHMil6w0Jvvw8FZnkqlB9pjIUfj9nebn2hTINpKBrbD14kIDYjj8dDMkZQ==";
    };
  };

  linuxPackageForArch =
    if platform.isAarch64 then
      linuxPackages.aarch64
    else if platform.isx86_64 then
      linuxPackages.x86_64
    else
      null;

  linuxPackage =
    if builtins.isNull linuxPackageForArch then
      null
    else if platform.isMusl then
      linuxPackageForArch.musl
    else
      linuxPackageForArch.gnu;

  packageInfo =
    if platform.isDarwin then
      if platform.isAarch64 then
        macPackages.aarch64
      else if platform.isx86_64 then
        macPackages.x86_64
      else
        null
    else if platform.isLinux then
      linuxPackage
    else if platform.isWindows then
      if platform.isAarch64 then
        winPackages.aarch64
      else if platform.isx86_64 then
        winPackages.x86_64
      else
        null
    else
      null;

  selectedPackage =
    if builtins.isNull packageInfo then
      throw "vite-plus is not packaged for ${platform.system}"
    else
      packageInfo;

  packageName = selectedPackage.packageName;
  integrityHash = selectedPackage.hash;

  supportedPlatforms = [
    "aarch64-darwin"
    "x86_64-darwin"
    "aarch64-linux"
    "x86_64-linux"
    "aarch64-windows"
    "x86_64-windows"
  ];
in
stdenvNoCC.mkDerivation rec {
  pname = "vite-plus";
  version = "0.3.3";

  src = fetchurl {
    url = "https://registry.npmjs.org/@voidzero-dev/vite-plus-cli-${packageName}/-/vite-plus-cli-${packageName}-${version}.tgz";
    hash = integrityHash;
  };

  dontConfigure = true;
  dontBuild = true;

  unpackPhase = builtins.readFile ../../src/templates/nix/pkgs/vite-plus/unpack.sh;

  installPhase = builtins.readFile ../../src/templates/nix/pkgs/vite-plus/install.sh;

  meta = {
    description = "Vite+ global CLI";
    homepage = "https://viteplus.dev/";
    sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
    license = lib.licenses.mit;
    platforms = supportedPlatforms;
    maintainers = [ ];
  };
};
in
package
