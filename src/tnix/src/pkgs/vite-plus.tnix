let
  package :: dynamic;
  # @tnix-ignore
  package = (args :: {
    stdenvNoCC :: dynamic;
    fetchurl :: dynamic;
    lib :: dynamic;
  }):
let
  stdenvNoCC = args.stdenvNoCC;
  fetchurl = args.fetchurl;
  lib = args.lib;
  platform = stdenvNoCC.hostPlatform;

  macPackages = {
    aarch64 = {
      packageName = "darwin-arm64";
      hash = "sha512-qC/avDevnPTCOBQe8oRZnfMxjbmickIQ8T6PaDHd245I24IbBXrD0Qie6gCpFF1SlHYGb+OA6RQKVYrLJTrC5Q==";
    };
    x86_64 = {
      packageName = "darwin-x64";
      hash = "sha512-tJdYieVlikJb1UR5/CWjGLe6unagCHpftxPqtH4pRnhof4Hx7iXK12f5xYGMNsqkw4eUVch24a93EDyMdlzJDA==";
    };
  };

  linuxPackages = {
    aarch64 = {
      gnu = {
        packageName = "linux-arm64-gnu";
        hash = "sha512-0MnV4y59poG/gj8b5M2SgxqIBPgVAvDGd2c8SnPtd7r/vvmAXx3Aoe5reSDBwLZ/X+q4GTiBNEAS6UeGXcIQyQ==";
      };
      musl = {
        packageName = "linux-arm64-musl";
        hash = "sha512-AgnDXxUJBCmnN8XahtI7k/urGVSBUrF033qiHBEvAkQjBdaQZKyBToUcBS0svDftfvYDduQ4JTYwUAdie4KA9Q==";
      };
    };
    x86_64 = {
      gnu = {
        packageName = "linux-x64-gnu";
        hash = "sha512-KAkMZTfsAdGq/1WfuLrZxy1nA9Q+rR5Vq9HEsVM7p4HZ/sMpqM5vPgmHdd0lZKm4pp/1RLQ87p0Vnn15dUFn5Q==";
      };
      musl = {
        packageName = "linux-x64-musl";
        hash = "sha512-CekRYyZN3Vbt3t14lrxzsRWIqXRQLJzuJO1YLu90Vk3YC0CpM2fRBofQgz7FLGp3nrAL9K0BFz4CMAn03TnrpA==";
      };
    };
  };

  winPackages = {
    aarch64 = {
      packageName = "win32-arm64-msvc";
      hash = "sha512-KizOPYpWR/hXgKkhJ7kyTmbBjj/zGYSne+ushhgKPSg43tC09g3NPc1lNjoBTUeli49OU7hpfOfp8MufY1OADg==";
    };
    x86_64 = {
      packageName = "win32-x64-msvc";
      hash = "sha512-FFYybcM1a0ADPDYK/sQCq5QAC8KZUjdixhzLbW3VY57kw5G1KnvC/DqnsHoLAXJ6now/sWK2+Rtl9LJkso31TA==";
    };
  };

  linuxPackageForArch =
    if platform.isAarch64 then
      linuxPackages.aarch64
    else if platform.isx86_64 then
      linuxPackages.x86_64
    else
      null;

  linuxPackage =
    if builtins.isNull linuxPackageForArch then
      null
    else if platform.isMusl then
      linuxPackageForArch.musl
    else
      linuxPackageForArch.gnu;

  packageInfo =
    if platform.isDarwin then
      if platform.isAarch64 then
        macPackages.aarch64
      else if platform.isx86_64 then
        macPackages.x86_64
      else
        null
    else if platform.isLinux then
      linuxPackage
    else if platform.isWindows then
      if platform.isAarch64 then
        winPackages.aarch64
      else if platform.isx86_64 then
        winPackages.x86_64
      else
        null
    else
      null;

  selectedPackage =
    if builtins.isNull packageInfo then
      throw "vite-plus is not packaged for ${platform.system}"
    else
      packageInfo;

  packageName = selectedPackage.packageName;
  integrityHash = selectedPackage.hash;

  supportedPlatforms = [
    "aarch64-darwin"
    "x86_64-darwin"
    "aarch64-linux"
    "x86_64-linux"
    "aarch64-windows"
    "x86_64-windows"
  ];
in
stdenvNoCC.mkDerivation rec {
  pname = "vite-plus";
  version = "0.3.0";

  src = fetchurl {
    url = "https://registry.npmjs.org/@voidzero-dev/vite-plus-cli-${packageName}/-/vite-plus-cli-${packageName}-${version}.tgz";
    hash = integrityHash;
  };

  dontConfigure = true;
  dontBuild = true;

  unpackPhase = builtins.readFile ../../src/templates/nix/pkgs/vite-plus/unpack.sh;

  installPhase = builtins.readFile ../../src/templates/nix/pkgs/vite-plus/install.sh;

  meta = {
    description = "Vite+ global CLI";
    homepage = "https://viteplus.dev/";
    sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
    license = lib.licenses.mit;
    platforms = supportedPlatforms;
    maintainers = [ ];
  };
};
in
package
