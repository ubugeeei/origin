let
  package :: dynamic;
  # @tynix-ignore
  package = (args :: {
    stdenvNoCC :: dynamic;
    fetchurl :: dynamic;
    lib :: dynamic;
  }):
let
  stdenvNoCC = args.stdenvNoCC;
  fetchurl = args.fetchurl;
  lib = args.lib;
  platform = stdenvNoCC.hostPlatform;

  macPackages = {
    aarch64 = {
      packageName = "darwin-arm64";
      hash = "sha512-PFpvpBUCqlvS1f2oCsNHnJSFHT7SOK/QeCJwhs/GLcvtOyyAY4tT6QmxyZzom4D33g63GfZ6y25e3yyFkchncg==";
    };
    x86_64 = {
      packageName = "darwin-x64";
      hash = "sha512-fjkt6aSsgfVZlc4EmLrAazA0PeFzsdSnRfGbh7fWn5UWGQJLiz0LDvCUyLcfmGoZQqDjhwkwBun2YkK1leNTnQ==";
    };
  };

  linuxPackages = {
    aarch64 = {
      gnu = {
        packageName = "linux-arm64-gnu";
        hash = "sha512-b0LzCEUoFiuezkGqp7153FygQlHUZ4ffyEatJ2U0R25g13vcjQ4sgqn9d1Nbdkw3eQQ/T5scb1TUS1YSc4IOzw==";
      };
      musl = {
        packageName = "linux-arm64-musl";
        hash = "sha512-HsjRshkFtv4aHgnicPr57z6OV5VojgcahsSbdYUPnsyWNA3Z1Gb5L7QjSpAmi7w0NOZeYEhEqVoziY2ZarEqNQ==";
      };
    };
    x86_64 = {
      gnu = {
        packageName = "linux-x64-gnu";
        hash = "sha512-lNnY8ULsZ1AdO1DiSDqHWfxq1kT91aUroMFFq2ROSG3SyP1cmmNkCvMdOiYlNPh1P8DamBYG2q2JoqUJlA4kMQ==";
      };
      musl = {
        packageName = "linux-x64-musl";
        hash = "sha512-u+l7ZaN5CRuwHMCuDEh+ZHeYPcvPQRyTHeNn2gQf4ZMocwm2CDjFFDQt6CruRtdBD4Zbg282CkVKNvv1sxFpdw==";
      };
    };
  };

  winPackages = {
    aarch64 = {
      packageName = "win32-arm64-msvc";
      hash = "sha512-KP05N7exKDUduHS4ZFGs+GAeoKX8gsC9SQgjNfFM3JsWbddBg94FDWZiynGx59VEpB4JeQD4rc/Bv6hQ+Z1PtA==";
    };
    x86_64 = {
      packageName = "win32-x64-msvc";
      hash = "sha512-Xq4oyeUjxn82+T2irZXWCFlavIDpifcrGXGCVz1Y5Et/XPaGPjRapT2aF6prqrhJEGZn8ybnEzUWA9tnFxFU6A==";
    };
  };

  linuxPackageForArch =
    if platform.isAarch64 then
      linuxPackages.aarch64
    else if platform.isx86_64 then
      linuxPackages.x86_64
    else
      null;

  linuxPackage =
    if builtins.isNull linuxPackageForArch then
      null
    else if platform.isMusl then
      linuxPackageForArch.musl
    else
      linuxPackageForArch.gnu;

  packageInfo =
    if platform.isDarwin then
      if platform.isAarch64 then
        macPackages.aarch64
      else if platform.isx86_64 then
        macPackages.x86_64
      else
        null
    else if platform.isLinux then
      linuxPackage
    else if platform.isWindows then
      if platform.isAarch64 then
        winPackages.aarch64
      else if platform.isx86_64 then
        winPackages.x86_64
      else
        null
    else
      null;

  selectedPackage =
    if builtins.isNull packageInfo then
      throw "vite-plus is not packaged for ${platform.system}"
    else
      packageInfo;

  packageName = selectedPackage.packageName;
  integrityHash = selectedPackage.hash;

  supportedPlatforms = [
    "aarch64-darwin"
    "x86_64-darwin"
    "aarch64-linux"
    "x86_64-linux"
    "aarch64-windows"
    "x86_64-windows"
  ];
in
stdenvNoCC.mkDerivation rec {
  pname = "vite-plus";
  version = "1.1.0";

  src = fetchurl {
    url = "https://registry.npmjs.org/@voidzero-dev/vite-plus-cli-${packageName}/-/vite-plus-cli-${packageName}-${version}.tgz";
    hash = integrityHash;
  };

  dontConfigure = true;
  dontBuild = true;

  unpackPhase = builtins.readFile ../../src/templates/nix/pkgs/vite-plus/unpack.sh;

  installPhase = builtins.readFile ../../src/templates/nix/pkgs/vite-plus/install.sh;

  meta = {
    description = "Vite+ global CLI";
    homepage = "https://viteplus.dev/";
    sourceProvenance = [ lib.sourceTypes.binaryNativeCode ];
    license = lib.licenses.mit;
    platforms = supportedPlatforms;
    maintainers = [ ];
  };
};
in
package
